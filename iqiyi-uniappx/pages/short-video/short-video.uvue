  font-size: 32px;
  color: #ffffff;
}
.action-text {
  color: #ffffff;
  font-size: 12px;
  margin-top: 4px;
  font-weight: bold;
}
.bottom-info {
  position: absolute;
  left: 16px;
  right: 80px; /* 避开右侧按钮 */
  bottom: 16px;
  display: flex;
  flex-direction: column;
  z-index: 10;
}
