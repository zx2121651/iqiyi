<template>
  <view class="container">
    <!-- 顶部导航 -->
    <view class="top-nav">
      <text class="nav-item">关注</text>
      <text class="nav-item active">推荐</text>
    </view>

    <!-- 全屏垂直滑动 swiper -->
    <swiper class="video-swiper" :vertical="true" :duration="300" :current="currentIndex" @change="onSwiperChange">
      <swiper-item v-for="(item, index) in videos" :key="index" class="video-item">
        <!-- 真实 Video 组件 -->
        <video
          v-if="index === currentIndex || index === currentIndex - 1 || index === currentIndex + 1"
          class="video-player"
          :id="'video_' + index"
          src="https://sample-videos.com/video123/mp4/720/big_buck_bunny_720p_1mb.mp4"
          :poster="item.coverUrl"
          :autoplay="index === currentIndex"
          :loop="true"
          :show-center-play-btn="false"
          :controls="false"
          object-fit="cover"
        ></video>
        <image v-else class="video-player" :src="item.coverUrl" mode="aspectFill"></image>

        <!-- 蒙层 -->
        <view class="overlay"></view>

        <!-- 右侧互动区 -->
        <view class="right-actions">
          <view class="action-item avatar-box">
            <image class="avatar" :src="item.authorAvatar" mode="aspectFill"></image>
            <view class="plus-icon"><text class="plus-text">+</text></view>
          </view>

          <view class="action-item" @click="handleLike(item)">
            <!-- 爱心使用简单的文字符号或者可以在项目里引入 iconfont，这里用符号代替 -->
            <text class="action-icon" :style="{ color: item.isLiked ? '#ff2b55' : '#ffffff' }">
              {{ item.isLiked ? '❤️' : '♡' }}
            </text>
            <text class="action-text">{{ formatCount(item.likeCount) }}</text>
          </view>

          <view class="action-item">
            <text class="action-icon">💬</text>
            <text class="action-text">{{ formatCount(item.commentCount) }}</text>
          </view>

          <view class="action-item" @click="openSharePanel">
            <text class="action-icon">↪️</text>
            <text class="action-text">{{ formatCount(item.shareCount) }}</text>
          </view>
        </view>

        <!-- 底部信息区 -->
        <view class="bottom-info">
          <text class="author-name">@{{ item.authorName }}</text>
          <text class="video-desc">{{ item.desc }}</text>
          <view class="music-box">
            <text class="music-icon">🎵</text>
            <text class="music-text">{{ item.authorName }} 的原声</text>
          </view>
        </view>
      </swiper-item>
    </swiper>

    <!-- 底部弹出的分享面板 -->
    <view class="share-mask" v-if="showShare" @click="closeSharePanel"></view>
    <view class="share-panel" :class="{'share-panel-show': showShare}">
      <view class="share-header">
        <text class="share-title">分享到</text>
        <text class="close-icon" @click="closeSharePanel">✕</text>
      </view>

      <view class="share-grid">
        <view class="share-item" @click="shareTo('微信好友')">
          <view class="share-icon-wrap" style="background-color: #09B83E;">
            <text class="share-icon">💬</text>
          </view>
          <text class="share-name">微信好友</text>
        </view>
        <view class="share-item" @click="shareTo('朋友圈')">
          <view class="share-icon-wrap" style="background-color: #09B83E;">
            <text class="share-icon">⭕</text>
          </view>
          <text class="share-name">朋友圈</text>
        </view>
        <view class="share-item" @click="shareTo('复制链接')">
          <view class="share-icon-wrap" style="background-color: #333333;">
            <text class="share-icon">🔗</text>
          </view>
          <text class="share-name">复制链接</text>
        </view>
      </view>

      <view class="share-actions">
        <view class="action-item-small" @click="shareTo('保存本地')">
          <view class="action-icon-wrap">
            <text class="action-icon-small">⬇️</text>
          </view>
          <text class="action-name">保存本地</text>
        </view>
      </view>

      <view class="cancel-btn" @click="closeSharePanel">
        <text class="cancel-text">取消</text>
      </view>
    </view>
  </view>
</template>

<script setup lang="uts">
import { shortVideoMockData } from '../../mock/shortVideo.uts'
import { ref } from 'vue'

// 短视频列表数据和当前活动索引
const videos = ref(shortVideoMockData.list)
const currentIndex = ref(0)

// 分享面板的显示状态
const showShare = ref(false)

/**
 * 监听 swiper 垂直滑动切换事件
 * 控制上一个视频暂停，当前视频播放，以优化性能
 * @param e 事件对象，包含 detail.current
 */
const onSwiperChange = (e: any) => {
  const prevIndex = currentIndex.value
  currentIndex.value = e.detail.current
  console.log('滑动到了视频索引:', currentIndex.value)

  // 获取上一个视频上下文并暂停播放
  const prevVideoContext = uni.createVideoContext('video_' + prevIndex)
  if(prevVideoContext) {
     prevVideoContext.pause()
  }

  // 获取当前可视视频上下文并开始播放
  const currentVideoContext = uni.createVideoContext('video_' + currentIndex.value)
  if(currentVideoContext) {
     currentVideoContext.play()
  }
}

/**
 * 格式化数值显示，超过 10000 转换为 w 单位
 */
const formatCount = (count: number): string => {
  if (count > 10000) {
    return (count / 10000).toFixed(1) + 'w';
  }
  return count.toString();
}

/**
 * 处理点赞操作
 * 切换点赞状态，并实时增减数据
 * @param item 当前操作的视频对象
 */
const handleLike = (item: any) => {
  item.isLiked = !item.isLiked
  if (item.isLiked) {
    item.likeCount += 1
  } else {
    item.likeCount -= 1
  }
}

/**
 * 展开分享面板
 */
const openSharePanel = () => {
  showShare.value = true
}

/**
 * 关闭分享面板
 */
const closeSharePanel = () => {
  showShare.value = false
}

/**
 * 模拟分享动作
 * @param target 目标渠道
 */
const shareTo = (target: string) => {
  uni.showToast({ title: '已' + (target==='复制链接'?'复制':'分享到') + target, icon: 'success' })
  closeSharePanel()
}
</script>

