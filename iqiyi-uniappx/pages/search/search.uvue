<template>
  <view class="container">
    <!-- 顶部搜索导航栏 -->
    <view class="search-header">
      <view class="back-btn" @click="goBack">
        <text class="back-icon">&lt;</text>
      </view>
      <view class="search-input-box">
        <text class="search-icon">🔍</text>
        <input
          class="search-input"
          type="text"
          v-model="keyword"
          placeholder="搜索全网影视、综艺、动漫"
          placeholder-class="placeholder-style"
          :focus="true"
          @confirm="onSearch"
          confirm-type="search"
        />
        <text v-if="keyword.length > 0" class="clear-icon" @click="clearKeyword">✕</text>
      </view>
      <text class="search-text-btn" @click="onSearch">搜索</text>
    </view>

    <!-- 搜索主体内容 -->
    <scroll-view class="search-content" scroll-y="true">
      <!-- 搜索发现与历史 (未输入或未搜索时显示) -->
      <view v-if="!isSearching">
        <!-- 搜索历史 -->
        <view class="history-section" v-if="historyList.length > 0">
          <view class="section-header">
            <text class="section-title">搜索历史</text>
            <text class="clear-btn" @click="clearHistory">🗑️</text>
          </view>
          <view class="tags-container">
            <text class="tag-item" v-for="(item, index) in historyList" :key="index" @click="handleTagClick(item)">
              {{ item }}
            </text>
          </view>
        </view>

        <!-- 爱奇艺热搜榜 -->
        <view class="hot-search-section">
          <view class="section-header">
            <text class="section-title">🔥 爱奇艺热搜榜</text>
          </view>
          <view class="hot-list">
            <view class="hot-item" v-for="(item, index) in hotSearches" :key="index" @click="handleTagClick(item.title)">
              <text class="hot-index" :class="{'top-index': index < 3}">{{ index + 1 }}</text>
              <text class="hot-title">{{ item.title }}</text>
              <view v-if="item.isHot" class="hot-tag"><text class="hot-tag-text">HOT</text></view>
            </view>
          </view>
        </view>
      </view>

      <!-- 搜索结果列表 (简易Mock) -->
      <view class="result-section" v-else>
        <text class="result-tip">为您找到 "{{ keyword }}" 的相关结果</text>
        <view class="result-list">
          <view class="result-card" v-for="(item, index) in mockResults" :key="index" @click="goToDetail(item.id)">
            <image class="result-cover" :src="item.cover" mode="aspectFill"></image>
            <view class="result-info">
              <text class="result-title">{{ item.title }}</text>
              <text class="result-desc">{{ item.desc }}</text>
              <view class="play-btn">
                <text class="play-btn-text">立即播放</text>
              </view>
            </view>
          </view>
        </view>
      </view>
    </scroll-view>
  </view>
</template>

<script setup lang="uts">
import { ref } from 'vue'

const keyword = ref('')
const isSearching = ref(false)
const historyList = ref<string[]>([])

// 模拟热搜数据
const hotSearches = [
  { title: '狂飙', isHot: true },
  { title: '三体', isHot: true },
  { title: '流浪地球2', isHot: false },
  { title: '苍兰诀', isHot: false },
  { title: '名侦探柯南', isHot: false }
]

// 模拟搜索结果数据
const mockResults = [
  { id: 'v1', title: '狂飙 电视剧全集在线观看', desc: '张译、张颂文主演的热播反黑剧。', cover: 'https://dummyimage.com/120x160/1f1f1f/fff&text=KB' },
  { id: 'v2', title: '狂飙 幕后花絮', desc: '看看张颂文是如何吃面条的。', cover: 'https://dummyimage.com/120x160/1f1f1f/fff&text=KBMH' }
]

// 生命周期 - 初始化读取历史记录
uni.getStorage({
  key: 'search_history',
  success: (res) => {
    try {
      if (res.data) {
        historyList.value = JSON.parse(res.data as string) as string[]
      }
    } catch(e) {}
  }
})

/**
 * 触发搜索
 */
const onSearch = () => {
  if (!keyword.value.trim()) return
  saveHistory(keyword.value)
  isSearching.value = true
}

/**
 * 清除输入框内容
 */
const clearKeyword = () => {
  keyword.value = ''
  isSearching.value = false
}

/**
 * 点击标签搜索
 */
const handleTagClick = (tag: string) => {
  keyword.value = tag
  onSearch()
}

/**
 * 保存搜索历史
 */
const saveHistory = (tag: string) => {
  const trimmed = tag.trim()
  if (!trimmed) return
  // 过滤重复并放到首位，最多保留10条
  let newList = historyList.value.filter(item => item !== trimmed)
  newList.unshift(trimmed)
  if (newList.length > 10) newList = newList.slice(0, 10)
  historyList.value = newList
  uni.setStorageSync('search_history', JSON.stringify(newList))
}

/**
 * 清除搜索历史
 */
const clearHistory = () => {
  historyList.value = []
  uni.removeStorageSync('search_history')
}

/**
 * 返回上一页
 */
const goBack = () => {
  uni.navigateBack({ delta: 1 })
}

/**
 * 跳转详情
 */
const goToDetail = (id: string) => {
  uni.navigateTo({ url: `/pages/video-detail/video-detail?id=${id}` })
}
</script>

<style>
