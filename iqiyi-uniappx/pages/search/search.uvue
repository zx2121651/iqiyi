  color: #888888;
  font-size: 12px;
}

.history-tags {
  display: flex;
  flex-direction: row;
  flex-wrap: wrap;
  margin-bottom: 24px;
}
.history-tag {
  background-color: #2a2a2a;
  border-radius: 16px;
  padding: 6px 12px;
  margin-right: 8px;
  margin-bottom: 8px;
}
