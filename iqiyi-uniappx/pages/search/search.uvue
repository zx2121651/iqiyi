  display: flex;
  flex: 1;
  flex-direction: column;
  background-color: #121212;
  height: 100%;
}

/* 顶部搜索栏 */
.search-header {
  display: flex;
  flex-direction: row;
  align-items: center;
  padding: 40px 16px 12px 16px;
  background-color: #1f1f1f;
  z-index: 100;
}

.back-btn {
  padding: 8px 8px 8px 0;
}

.back-icon {
  color: #ffffff;
  font-size: 20px;
  font-weight: bold;
}

.search-input-box {
  flex: 1;
  display: flex;
  flex-direction: row;
  align-items: center;
  background-color: rgba(255, 255, 255, 0.1);
  border-radius: 20px;
  height: 36px;
  padding: 0 12px;
  margin: 0 12px;
}

.search-icon {
  color: #888888;
  font-size: 14px;
  margin-right: 8px;
}

.search-input {
  flex: 1;
  color: #ffffff;
  font-size: 14px;
  background-color: transparent;
}

.placeholder-style {
  color: #888888;
}

.clear-icon {
  color: #888888;
  font-size: 14px;
  padding: 4px;
}

.search-text-btn {
  color: #00cc33;
  font-size: 16px;
  font-weight: bold;
}

/* 内容区 */
.search-content {
  flex: 1;
  padding: 16px;
}

/* 历史区与热搜区通用头部 */
.section-header {
  display: flex;
  flex-direction: row;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 16px;
}

.section-title {
  color: #ffffff;
  font-size: 16px;
  font-weight: bold;
}

.clear-btn {
  font-size: 16px;
  color: #888888;
}

/* 标签列表 */
.tags-container {
  display: flex;
  flex-direction: row;
  flex-wrap: wrap;
  margin-bottom: 32px;
}

.tag-item {
  background-color: #1f1f1f;
  color: #cccccc;
  font-size: 12px;
  padding: 6px 12px;
  border-radius: 16px;
  margin-right: 12px;
  margin-bottom: 12px;
}

/* 热搜榜 */
.hot-search-section {
  margin-bottom: 32px;
}

.hot-list {
  display: flex;
  flex-direction: column;
}

