  font-weight: bold;
  lines: 2;
  text-overflow: ellipsis;
}

.result-desc {
  color: #888888;
  font-size: 12px;
  margin-top: 8px;
  lines: 2;
  text-overflow: ellipsis;
}

.play-btn {
  align-self: flex-start;
  border-width: 1px;
  border-color: #00cc33;
  border-style: solid;
  border-radius: 16px;
  padding: 4px 16px;
  margin-top: 12px;
}

.play-btn-text {
  color: #00cc33;
  font-size: 12px;
}
</style>
