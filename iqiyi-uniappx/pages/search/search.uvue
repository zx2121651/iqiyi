<template>
  <view class="container">
    <!-- 搜索头部 -->
    <view class="search-header">
      <view class="back-btn" @click="goBack">
        <text class="back-icon">&lt;</text>
      </view>
      <view class="search-input-box">
        <text class="search-icon">🔍</text>
        <input
          class="search-input"
          type="text"
          placeholder="搜索你想看的影视综"
          placeholder-style="color:#888"
          v-model="keyword"
          @confirm="onSearch(keyword)"
          :focus="true"
        />
        <text class="clear-icon" v-if="keyword" @click="keyword=''">×</text>
      </view>
      <text class="search-btn" @click="onSearch(keyword)">搜索</text>
    </view>

    <scroll-view class="search-content" scroll-y="true">
      <!-- 搜索历史 -->
      <view class="history-section" v-if="history.length > 0">
        <view class="section-header">
          <text class="section-title">搜索历史</text>
          <text class="clear-btn" @click="clearHistory">清除</text>
        </view>
        <view class="history-tags">
          <view class="history-tag" v-for="(item, index) in history" :key="index" @click="onSearch(item)">
            <text class="history-text">{{ item }}</text>
          </view>
        </view>
      </view>

      <!-- 热搜榜 -->
      <view class="hot-section">
        <view class="section-header">
          <text class="section-title hot-title">🔥 爱奇艺热搜榜</text>
        </view>
        <view class="hot-list">
          <view class="hot-item" v-for="(item, index) in hotSearches" :key="item.id" @click="onSearch(item.text)">
            <text class="hot-rank" :class="{ 'hot-rank-top': index < 3 }">{{ index + 1 }}</text>
            <text class="hot-text">{{ item.text }}</text>
            <text class="hot-badge" v-if="item.isHot">HOT</text>
          </view>
        </view>
      </view>
    </scroll-view>
  </view>
</template>

<script setup lang="uts">
import { ref } from 'vue'

const keyword = ref('')
const history = ref(['狂飙', '流浪地球2', '种地吧'])

const hotSearches = [
  { id: 1, text: '三体', isHot: true },
  { id: 2, text: '长风渡', isHot: true },
  { id: 3, text: '莲花楼', isHot: false },
  { id: 4, text: '中国说唱巅峰对决', isHot: false },
  { id: 5, text: '显微镜下的大明', isHot: false },
  { id: 6, text: '独行月球', isHot: false },
]

const goBack = () => {
  uni.navigateBack({ delta: 1 })
}

const onSearch = (text: string) => {
  if (!text) return
  uni.showToast({ title: '搜索: ' + text, icon: 'none' })
  if (!history.value.includes(text)) {
    history.value.unshift(text)
    if (history.value.length > 10) {
      history.value.pop()
    }
  }
}

const clearHistory = () => {
  history.value = []
}
</script>

