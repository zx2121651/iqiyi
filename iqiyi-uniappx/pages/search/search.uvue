  display: flex;
  flex-direction: row;
  align-items: center;
  margin-bottom: 16px;
}

.hot-index {
  width: 24px;
  color: #888888;
  font-size: 16px;
  font-weight: bold;
  font-style: italic;
}

.top-index {
  color: #ff4d4f;
}

.hot-title {
  color: #cccccc;
  font-size: 14px;
  flex: 1;
}

.hot-tag {
  background-color: rgba(255, 77, 79, 0.2);
  padding: 2px 4px;
  border-radius: 4px;
}

.hot-tag-text {
  color: #ff4d4f;
  font-size: 10px;
  font-weight: bold;
}

/* 搜索结果区 */
.result-section {
  display: flex;
  flex-direction: column;
}

.result-tip {
  color: #888888;
  font-size: 12px;
  margin-bottom: 16px;
}

.result-list {
  display: flex;
  flex-direction: column;
}

.result-card {
  display: flex;
  flex-direction: row;
  background-color: #1f1f1f;
  border-radius: 8px;
  padding: 12px;
