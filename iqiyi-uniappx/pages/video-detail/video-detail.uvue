<template>
  <view class="container">
    <!-- 固定在顶部的导航 -->
    <view class="nav-bar">
      <view class="back-btn" @click="goBack">
        <text class="back-icon">&lt;</text>
      </view>
    </view>

    <!-- 视频播放器 (16:9 比例) -->
    <view class="video-wrapper">
      <video
        id="myVideo"
        class="video-player"
        :src="detail.playUrl"
        :poster="detail.coverUrl"
        autoplay="true"
        controls="true"
        object-fit="contain">
      </video>
    </view>

    <scroll-view class="content-scroll" scroll-y="true">
      <view class="detail-section">
        <!-- 标题 -->
        <text class="video-title">{{ detail.title }}</text>

        <!-- 数据信息 -->
        <view class="meta-info">
          <text class="score-text">{{ detail.score.toString() }}分</text>
          <text class="meta-text">{{ detail.year }}</text>
          <text class="meta-text">{{ formatCount(detail.playCount) }}次播放</text>
        </view>

        <!-- 标签 -->
        <view class="tag-list">
          <text class="tag-item" v-for="(tag, index) in detail.tags" :key="index">{{ tag }}</text>
        </view>

        <!-- 简介 -->
        <text class="video-desc">{{ detail.desc }}</text>

        <!-- 操作区 -->
        <view class="action-bar">
          <view class="action-btn">
            <text class="action-icon">❤️</text>
            <text class="action-num">{{ formatCount(detail.likeCount) }}</text>
          </view>
          <view class="action-btn">
            <text class="action-icon">⭐</text>
            <text class="action-num">收藏</text>
          </view>
          <view class="action-btn">
            <text class="action-icon">⬇️</text>
            <text class="action-num">下载</text>
          </view>
          <view class="action-btn">
            <text class="action-icon">💬</text>
            <text class="action-num">{{ formatCount(detail.commentCount) }}</text>
          </view>
          <view class="action-btn">
            <text class="action-icon">🔗</text>
            <text class="action-num">分享</text>
          </view>
        </view>
      </view>

      <!-- 更多推荐 -->
      <view class="recommend-section">
        <text class="recommend-header">更多推荐</text>
        <view class="related-list">
          <view class="related-item" v-for="(item, index) in related" :key="index" @click="reloadPage(item.id)">
            <view class="related-cover-wrap">
              <image class="related-cover" :src="item.coverUrl" mode="aspectFill"></image>
              <view class="duration-badge"><text class="duration-text">{{ item.duration }}</text></view>
            </view>
            <view class="related-info">
              <text class="related-title">{{ item.title }}</text>
              <text class="related-meta">{{ formatCount(item.playCount) }}次播放</text>
            </view>
          </view>
        </view>
      </view>
    </scroll-view>
  </view>
</template>

<script setup lang="uts">
import { videoDetailMockData } from '../../mock/videoDetail.uts'
import { ref } from 'vue'

const detail = ref(videoDetailMockData.detail)
const related = ref(videoDetailMockData.related)

const formatCount = (count: number): string => {
  if (count > 10000) {
    return (count / 10000).toFixed(1) + 'w';
  }
  return count.toString();
}

const goBack = () => {
  uni.navigateBack({ delta: 1 })
}

const reloadPage = (id: string) => {
  // 模拟重新加载同一页面刷新数据 (实际项目中应替换为重新 fetch)
  uni.showToast({ title: '加载视频 ' + id, icon: 'none' })
}
</script>

