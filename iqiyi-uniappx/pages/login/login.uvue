<template>
  <view class="container">
    <!-- 顶部导航栏 -->
    <view class="nav-bar">
      <view class="back-btn" @click="goBack">
        <text class="back-icon">&lt;</text>
      </view>
    </view>

    <!-- 登录主体内容区 -->
    <view class="login-body">
      <text class="logo-title">iQIYI</text>
      <text class="welcome-text">欢迎回来，即刻开启精彩视界</text>

      <!-- 登录表单 -->
      <view class="form-group">
        <input class="input-field" type="number" placeholder="请输入手机号" v-model="phone" placeholder-class="placeholder-style" />
      </view>

      <view class="form-group">
                <view class="input-wrapper">
          <input class="input-field code-input" type="number" placeholder="请输入验证码" v-model="code" placeholder-class="placeholder-style" maxlength="6" />
          <text class="get-code-btn" :class="countdown > 0 || phone.length === 0 ? 'btn-disabled' : ''" @click="handleGetCode">
            {{ countdown > 0 ? countdown + 's 后重新获取' : '获取验证码' }}
          </text>
        </view>
      </view>

      <!-- 错误提示文本 -->
      <text v-if="error" class="error-text">{{ error }}</text>

      <!-- 登录按钮 -->
      <button class="login-btn" :class="{'btn-loading': loading}" @click="handleLogin" :disabled="loading">
        <text class="btn-text">{{ loading ? '登录中...' : '登 录' }}</text>
      </button>

      <!-- 其他选项 -->
      <view class="other-links">
        <text class="link-text">忘记密码</text>
        <text class="link-divider">|</text>
        <text class="link-text">注册账号</text>
      </view>
    </view>
  </view>
</template>

<script setup lang="uts">
import { ref } from 'vue'
import { onUnload } from '@dcloudio/uni-app'
import { useAuthStore } from '../../store/auth.uts'

const authStore = useAuthStore()
// 表单绑定状态
const phone = ref('')
const code = ref('')
const countdown = ref(0)
const loading = ref(false)
const error = ref('')
let timer: number = 0

// 获取验证码逻辑
const handleGetCode = () => {
  if (phone.value.length < 11) {
    uni.showToast({ title: '请输入有效的手机号', icon: 'none' })
    return
  }
  if (countdown.value > 0) return

  countdown.value = 60
  timer = setInterval(() => {
    countdown.value--
    if (countdown.value <= 0) {
      clearInterval(timer)
      timer = 0
    }
  }, 1000) as number
}


/**
 * 原生返回上一页
 */
const goBack = () => {
  uni.navigateBack({ delta: 1 })
}

/**
 * 模拟登录逻辑
 * 校验输入 -> 设置加载状态 -> 延迟模拟请求 -> 状态同步存储 -> 路由回退
 */
const handleLogin = () => {
  if (!phone.value || !code.value) {
    error.value = '请输入手机号和验证码'
    return
  }
  error.value = ''
  loading.value = true

  // 模拟网络请求延迟
  setTimeout(() => {
    // 调用 Pinia Action 更新并持久化状态
    authStore.login({
      id: 'u10001',
      nickname: `用户_${phone.value.slice(-4)}`,
      avatar: 'https://dummyimage.com/100x100/333/fff&text=VIP',
      isVip: true,
      vipExpireTime: '2025-12-31'
    })

    loading.value = false
    uni.showToast({ title: '登录成功', icon: 'success' })
    setTimeout(() => {
      uni.navigateBack({ delta: 1 })
    }, 1000)
  }, 1500)
}
onUnload(() => {
  if (timer > 0) {
    clearInterval(timer);
  }
});
</script>

<style>
.container {
  display: flex;
  flex: 1;
  flex-direction: column;
  background-color: #121212;
  height: 100%;
}

.nav-bar {
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  height: 80px;
  padding: 40px 16px 0 16px;
  z-index: 100;
  display: flex;
  flex-direction: row;
  align-items: center;
}

.back-btn {
  width: 32px;
  height: 32px;
  border-radius: 16px;
  background-color: rgba(255, 255, 255, 0.1);
  display: flex;
  justify-content: center;
  align-items: center;
}

.back-icon {
  color: #ffffff;
  font-size: 18px;
  font-weight: bold;
}

.login-body {
  flex: 1;
  display: flex;
  flex-direction: column;
  justify-content: center;
  padding: 0 32px;
  margin-top: -80px; /* 向上偏移一点让视觉中心居中 */
}

.logo-title {
  color: #00cc33;
  font-size: 32px;
  font-weight: bold;
  font-style: italic;
  margin-bottom: 8px;
  letter-spacing: 2px;
}

.welcome-text {
  color: rgba(255, 255, 255, 0.9);
  font-size: 20px;
  font-weight: bold;
  margin-bottom: 32px;
}

.form-group {
  margin-bottom: 24px;
  border-bottom-width: 1px;
  border-bottom-color: #333333;
  border-bottom-style: solid;
}

.input-field {
  width: 100%;
  height: 48px;
  color: #ffffff;
  font-size: 18px;
  background-color: transparent;
  padding-bottom: 8px;
}

.placeholder-style {
  color: #666666;
}

.error-text {
  color: #ff4d4f;
  font-size: 12px;
  margin-bottom: 16px;
}

.login-btn {
  width: 100%;
  height: 48px;
  border-radius: 24px;
  background-color: #00cc33;
  display: flex;
  justify-content: center;
  align-items: center;
  margin-top: 16px;
}

.btn-loading {
  background-color: rgba(0, 204, 51, 0.5);
}

.btn-text {
  color: #ffffff;
  font-size: 16px;
  font-weight: bold;
}

.other-links {
  display: flex;
  flex-direction: row;
  justify-content: center;
  align-items: center;
  margin-top: 32px;
}

.link-text {
  color: #888888;
  font-size: 14px;
}

.link-divider {
  color: #555555;
  font-size: 14px;
  margin: 0 16px;
}
</style>
