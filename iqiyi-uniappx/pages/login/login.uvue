<template>
  <view class="container">
    <view class="header">
      <text class="back-icon" @click="goBack">✕</text>
      <text class="help-text">帮助</text>
    </view>

    <view class="content">
      <text class="title">手机号快捷登录</text>
      <text class="subtitle">未注册的手机号验证后自动创建爱奇艺账号</text>

      <view class="form-group">
        <view class="input-row border-bottom">
          <text class="country-code">+86</text>
          <input class="input-field" type="number" placeholder="请输入手机号" placeholder-style="color:#666" maxlength="11" v-model="phone" />
        </view>

        <view class="input-row border-bottom">
          <input class="input-field" type="number" placeholder="请输入验证码" placeholder-style="color:#666" maxlength="6" v-model="code" />
          <text class="get-code-btn" :class="{'disabled-text': isSending}" @click="handleSendCode">
            {{ isSending ? countdown + 's 后重新获取' : '获取验证码' }}
          </text>
        </view>

        <view class="login-btn-wrap" @click="handleLogin">
          <text class="login-btn" :class="{'active-btn': canLogin}">登录/注册</text>
        </view>
      </view>

      <view class="agreement">
        <text class="agree-text">登录即代表同意 <text class="brand-text">《爱奇艺服务协议》</text> 和 <text class="brand-text">《隐私政策》</text></text>
      </view>

      <view class="other-login">
        <text class="other-text">其他登录方式</text>
        <view class="social-icons">
          <view class="social-icon"><text class="icon-wx">微信</text></view>
          <view class="social-icon"><text class="icon-qq">QQ</text></view>
          <view class="social-icon"><text class="icon-apple">Apple</text></view>
        </view>
      </view>
    </view>
  </view>
</template>

<script setup lang="uts">
import { ref, computed } from 'vue'
import { useAuthStore } from '../../store/auth'

const authStore = useAuthStore()

const phone = ref('13800138000')
const code = ref('')
const isSending = ref(false)
const countdown = ref(60)

const canLogin = computed((): boolean => {
  return phone.value.length == 11 && code.value.length >= 4
})

const goBack = () => {
  uni.navigateBack({ delta: 1 })
}

const handleSendCode = () => {
  if (phone.value.length !== 11) {
    uni.showToast({ title: '请输入正确的手机号', icon: 'none' })
    return
  }
  if (isSending.value) return

  isSending.value = true
  uni.showToast({ title: '验证码已发送: 1234', icon: 'none' })
  code.value = '1234'

  let timer = setInterval(() => {
    if (countdown.value <= 1) {
      clearInterval(timer)
      isSending.value = false
      countdown.value = 60
    } else {
      countdown.value -= 1
    }
  }, 1000)
}

const handleLogin = () => {
  if (!canLogin.value) {
    uni.showToast({ title: '请输入正确的手机号和验证码', icon: 'none' })
    return
  }

  authStore.login({
    id: '12345678',
    name: 'VIP用户',
    isVip: true,
    avatar: 'https://dummyimage.com/100x100/e8c081/333&text=VIP'
  })

  uni.navigateBack({ delta: 1 })
}
</script>

