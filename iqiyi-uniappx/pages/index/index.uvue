<template>
  <scroll-view class="container" :scroll-y="true" @refresherrefresh="onRefresh" :refresher-enabled="true" :refresher-triggered="isRefreshing" @scrolltolower="onLoadMore">
    <!-- 顶部导航条 -->
    <view class="top-nav">
      <text class="logo">iQIYI</text>
      <view class="nav-links">
        <text
          class="nav-item"
          :class="{'active': activeTab === tab}"
          v-for="tab in tabs"
          :key="tab"
          @click="switchTab(tab)"
        >{{ tab }}</text>
        <text class="search-icon" @click="goToSearch">🔍</text>
      </view>
    </view>

    <!-- 轮播图区域 (Mock) -->
    <swiper class="banner-swiper" :indicator-dots="true" :autoplay="true" :interval="3000" indicator-color="rgba(255,255,255,0.5)" indicator-active-color="#00cc33">
      <swiper-item v-for="(item, index) in banners" :key="index">
        <image class="banner-image" :src="item.imageUrl" mode="aspectFill"></image>
        <view class="banner-title-bg">
          <text class="banner-title">{{ item.title }}</text>
        </view>
      </swiper-item>
    </swiper>

    <!-- 分类金刚区 (Kingkong 图标导航) -->
    <view class="kingkong-grid">
      <view class="kingkong-item" v-for="(item, index) in kingKongList" :key="index" @click="clickKingKong(item.name)">
        <view class="kingkong-icon-wrap" :style="{ backgroundColor: item.bgColor }">
          <text class="kingkong-icon" :style="{ color: item.iconColor }">{{ item.icon }}</text>
        </view>
        <text class="kingkong-text">{{ item.name }}</text>
      </view>
    </view>

    <!-- 继续观看 -->
    <view class="continue-watching" @click="goToDetail('v1')">
      <view class="cw-info">
        <text class="cw-time">上次观看到 12:45</text>
        <text class="cw-title">三体 第12集</text>
      </view>
      <view class="cw-play-btn">
        <text class="cw-play-icon">▶</text>
      </view>
    </view>

    <!-- 重磅热播 (横向滚动) -->
    <view class="section-title">
      <text class="section-title-text">重磅热播</text>
    </view>
    <scroll-view class="hot-scroll" :scroll-x="true">
      <view class="hot-list">
        <view class="hot-item" v-for="(item, index) in videos.slice(0, 5)" :key="'hot-'+index" @click="goToDetail(item.id)">
          <view class="hot-cover-wrap">
            <image class="hot-cover" :src="item.coverUrl" mode="aspectFill"></image>
            <view class="vip-tag-small" v-if="item.isVip"><text class="vip-text-small">VIP</text></view>
          </view>
          <text class="hot-title">{{ item.title }}</text>
        </view>
      </view>
    </scroll-view>

    <!-- 专属频道卡片 (正在热播) -->
    <view class="special-channel" v-if="videos.length >= 3">
      <view class="sc-header">
        <view class="sc-title-box">
          <text class="sc-title">🔥 正在热播</text>
          <text class="sc-subtitle">全网首播，不容错过</text>
        </view>
        <text class="sc-more">查看更多 &gt;</text>
      </view>

      <view class="sc-layout">
        <!-- 左大图 -->
        <view class="sc-left" @click="goToDetail(videos[0].id)">
          <image class="sc-cover" :src="videos[0].coverUrl" mode="aspectFill"></image>
          <view class="sc-bottom-mask">
            <text class="sc-video-title">{{ videos[0].title }}</text>
          </view>
        </view>

        <!-- 右双图 -->
        <view class="sc-right">
          <view class="sc-right-item" @click="goToDetail(videos[1].id)">
            <image class="sc-cover" :src="videos[1].coverUrl" mode="aspectFill"></image>
            <view class="sc-bottom-mask">
              <text class="sc-video-title">{{ videos[1].title }}</text>
            </view>
          </view>
          <view class="sc-right-item mt-gap" @click="goToDetail(videos[2].id)">
            <image class="sc-cover" :src="videos[2].coverUrl" mode="aspectFill"></image>
            <view class="sc-bottom-mask">
              <text class="sc-video-title">{{ videos[2].title }}</text>
            </view>
          </view>
        </view>
      </view>
    </view>

    <!-- 热门推荐列表 -->
    <view class="section-title">
      <text class="section-title-text">热门推荐</text>
    </view>

    <view class="video-grid">
      <view class="video-card" v-for="(item, index) in videos" :key="index" @click="goToDetail(item.id)" @touchstart="onTouchStart(index)" @touchend="onTouchEnd(index)" @touchcancel="onTouchEnd(index)" :style="getCardStyle(index)">
        <view class="card-cover-wrap">
          <image class="card-cover" :src="item.coverUrl" mode="aspectFill"></image>
          <!-- VIP标识 -->
          <view class="vip-tag" v-if="item.isVip">
            <text class="vip-text">VIP</text>
          </view>
          <!-- 底部信息条 -->
          <view class="card-bottom-info">
            <text class="score-text">{{ item.score.toString() }}</text>
            <text class="play-count-text">{{ formatCount(item.playCount) }}</text>
          </view>
        </view>
        <text class="card-title">{{ item.title }}</text>
        <text class="card-desc">{{ item.desc }}</text>
      </view>
    </view>
    <view class="loading-more" v-if="isLoadingMore">
      <text class="loading-text">加载更多中...</text>
    </view>
  </scroll-view>
</template>

<script setup lang="uts">
import { homeMockData } from '../../mock/home.uts'
import { ref } from 'vue'

// 首页状态定义
const banners = ref(homeMockData.banners) // 轮播图数据
const videos = ref(homeMockData.videos)   // 视频列表数据
const isRefreshing = ref(false)           // 下拉刷新状态
const isLoadingMore = ref(false)          // 上拉加载更多状态
const activeCardIndex = ref(-1)           // 当前按压（按住）的视频卡片索引，用于模拟触感反馈微动画
const page = ref(1)                       // 列表当前页码

// 分类金刚区静态数据
const kingKongList = [
  { name: 'VIP专区', icon: '👑', bgColor: '#3a280c', iconColor: '#e8c081' },
  { name: '动漫', icon: '✨', bgColor: 'rgba(168, 85, 247, 0.2)', iconColor: '#c084fc' },
  { name: '纪录片', icon: '🎞️', bgColor: 'rgba(59, 130, 246, 0.2)', iconColor: '#60a5fa' },
  { name: '游戏', icon: '🎮', bgColor: 'rgba(34, 197, 94, 0.2)', iconColor: '#4ade80' },
  { name: '音乐', icon: '🎵', bgColor: 'rgba(236, 72, 153, 0.2)', iconColor: '#f472b6' }
]

// 顶部频道 Tab
const tabs = ['推荐', '电视剧', '电影', '综艺']
const activeTab = ref('推荐')

/**
 * 点击金刚区分类
 */
const clickKingKong = (name: string) => {
  uni.showToast({ title: '点击分类: ' + name, icon: 'none' })
}

/**
 * 切换顶部 Tab
 * @param tab 选中的频道名
 */
const switchTab = (tab: string) => {
  if (activeTab.value === tab) return
  activeTab.value = tab
  page.value = 1 // 重置分页
  // 模拟网络请求加载不同频道的数据
  uni.showLoading({ title: '加载中' })
  setTimeout(() => {
    // 打乱顺序模拟新数据
    banners.value = [...homeMockData.banners].sort(() => Math.random() - 0.5)
    videos.value = [...homeMockData.videos].sort(() => Math.random() - 0.5)
    uni.hideLoading()
  }, 500)
}

/**
 * 触摸视频卡片开始事件：记录被按压卡片的索引
 */
const onTouchStart = (index: number) => {
  activeCardIndex.value = index
}

/**
 * 触摸视频卡片结束或取消事件：重置按压状态
 */
const onTouchEnd = (index: number) => {
  activeCardIndex.value = -1
}

/**
 * 获取卡片按压反馈样式
 * 配合 @touchstart / @touchend 实现手势微缩放效果
 */
const getCardStyle = (index: number): string => {
  if (activeCardIndex.value === index) {
    return 'transform: scale(0.95); transition: transform 0.2s;'
  }
  return 'transform: scale(1); transition: transform 0.2s;'
}

/**
 * 格式化播放量数字 (如：超过万转为 'x.xw')
 */
const formatCount = (count: number): string => {
  if (count > 10000) {
    return (count / 10000).toFixed(1) + 'w';
  }
  return count.toString();
}

/**
 * 跳转至视频详情页
 */
const goToDetail = (id: string) => {
  uni.navigateTo({
    url: '/pages/video-detail/video-detail?id=' + id
  })
}

/**
 * 跳转至搜索页
 */
const goToSearch = () => {
  uni.navigateTo({
    url: '/pages/search/search'
  })
}

/**
 * 原生下拉刷新逻辑
 * 触发 scroll-view 的 @refresherrefresh 事件
 */
const onRefresh = () => {
  isRefreshing.value = true
  page.value = 1 // 重置分页
  // 模拟请求延迟
  setTimeout(() => {
    // 打乱数据模拟刷新
    videos.value = [...homeMockData.videos].sort(() => Math.random() - 0.5)
    isRefreshing.value = false
    uni.showToast({ title: '刷新成功', icon: 'none' })
  }, 1000)
}

/**
 * 原生上拉加载更多逻辑 (真实分页模拟)
 * 触发 scroll-view 的 @scrolltolower 事件
 */
const onLoadMore = () => {
  if (isLoadingMore.value) return
  isLoadingMore.value = true

  // 模拟请求延迟
  setTimeout(() => {
    const nextPage = page.value + 1
    // 模拟生成分页标记的新数据，而不是单纯复制
    const moreVideos = homeMockData.videos.slice(0, 4).map(v => ({
      ...v,
      id: v.id + '_page_' + nextPage + '_' + Date.now(),
      title: v.title.replace(/\(新第\d+页\)$/, '') + ' (新第' + nextPage + '页)',
      playCount: Math.floor(Math.random() * 50000)
    }))

    videos.value.push(...moreVideos)
    page.value = nextPage
    isLoadingMore.value = false
  }, 1000)
}

console.log('首页加载完成，获取到Mock数据：', videos.value.length)
</script>

