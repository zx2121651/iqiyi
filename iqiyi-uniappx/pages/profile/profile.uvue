<template>
  <scroll-view class="container" :scroll-y="true">
    <!-- 头部区域，渐变背景 -->
    <view class="header-section">
      <view class="header-top">
        <text class="page-title">我的</text>
        <text class="settings-icon" @click="goToSettings">⚙️</text>
      </view>

      <!-- 用户信息展示区 (通过 store 判断是否登录) -->
      <view class="user-info-box" v-if="authStore.isLoggedIn" @click="goToSettings">
        <image class="avatar" :src="authStore.userInfo?.avatar || 'https://dummyimage.com/100/333/fff'" mode="aspectFill"></image>
        <view class="info-content">
          <text class="nickname">{{ authStore.userInfo?.nickname }}</text>
          <view class="vip-badge" v-if="authStore.userInfo?.isVip">
            <text class="vip-icon">👑</text>
            <text class="vip-text">VIP会员 (至 {{ authStore.userInfo?.vipExpireTime }})</text>
          </view>
          <text class="normal-user" v-else>普通用户</text>
        </view>
      </view>

      <!-- 未登录引导 -->
      <view class="user-info-box not-logged-in" v-else @click="goToLogin">
        <view class="avatar default-avatar">
          <text class="default-avatar-text">未登录</text>
        </view>
        <view class="info-content">
          <text class="login-prompt">点击登录/注册</text>
          <text class="login-desc">登录后畅享高清画质及多端同步记录</text>
        </view>
        <text class="arrow-icon">></text>
      </view>
    </view>

    <!-- 快捷功能金刚区 -->
    <view class="quick-nav-container">
      <view class="quick-nav">
        <view class="nav-item" v-for="(item, index) in menuList" :key="index" @click="handleMenuClick(item.label)">
          <view class="icon-wrap">
            <text class="nav-icon" :style="{color: item.color}">{{ item.icon }}</text>
          </view>
          <text class="nav-label">{{ item.label }}</text>
        </view>
      </view>
    </view>

    <!-- 列表选项区 -->
    <view class="list-section">
      <view class="list-item" @click="handleMenuClick('我的预约')">
        <text class="list-title">我的预约</text>
        <text class="list-arrow">></text>
      </view>
      <view class="list-item" @click="handleMenuClick('帮助与客服')">
        <text class="list-title">帮助与客服</text>
        <text class="list-arrow">></text>
      </view>
      <view class="list-item border-none" @click="handleMenuClick('关于我们')">
        <text class="list-title">关于我们</text>
        <text class="list-arrow">></text>
      </view>
    </view>

    <!-- 退出登录按钮 (仅登录后可见) -->
    <button class="logout-btn" v-if="authStore.isLoggedIn" @click="handleLogout">
      <text class="logout-text">退出登录</text>
    </button>
  </scroll-view>
</template>

<script setup lang="uts">
import { ref } from 'vue'
import { useAuthStore } from '../../store/auth.uts'

// 初始化全局认证状态管理
const authStore = useAuthStore()
// 组件挂载时尝试从本地缓存恢复登录态
// authStore.initAuth() 会在 App.uvue 或入口处执行，这里直接使用 state

/**
 * 快捷导航数据配置
 */
const menuList = [
  { icon: '🕒', label: '历史记录', color: '#60a5fa' },
  { icon: '⭐', label: '我的收藏', color: '#facc15' },
  { icon: '⬇️', label: '我的下载', color: '#4ade80' },
  { icon: '❤️', label: '我的点赞', color: '#f87171' }
]

/**
 * 跳转到登录页面
 */
const goToLogin = () => {
  uni.navigateTo({ url: '/pages/login/login' })
}

/**
 * 跳转到设置页面 (待实现)
 */
const goToSettings = () => {
  uni.showToast({ title: '设置功能开发中', icon: 'none' })
}

/**
 * 通用菜单点击提示
 */
const handleMenuClick = (label: string) => {
  uni.showToast({ title: '点击: ' + label, icon: 'none' })
}

/**
 * 退出登录逻辑
 */
const handleLogout = () => {
  uni.showModal({
    title: '提示',
    content: '确定要退出登录吗？',
    success: (res) => {
      if (res.confirm) {
        authStore.logout()
        uni.showToast({ title: '已退出登录', icon: 'success' })
      }
    }
  })
}
</script>

